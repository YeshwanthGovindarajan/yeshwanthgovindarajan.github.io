---
import Layout from "@/layouts/Layout.astro";
import { researchItems, groupOrder } from "@/data/research";

const statusColor = (status: string) => {
  const s = status.toLowerCase();
  if (s.includes("published")) return "var(--sec)";
  if (s.includes("review")) return "#f5a623";
  if (s.includes("filed")) return "#7ea6ff";
  return "var(--white-icon)";
};
---

<Layout
  title="Research & Patents"
  description="Peer-reviewed papers and patents by Yeshwanth Govindarajan across multimodal AI, federated learning, biometrics, and applied deep learning."
>
  <div class="max-w-4xl mx-auto pt-10">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm text-[var(--white-icon)] hover:text-white transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
        <path d="M10.8284 12.0007L15.7782 16.9504L14.364 18.3646L8 12.0007L14.364 5.63672L15.7782 7.05093L10.8284 12.0007Z" />
      </svg>
      Back to portfolio
    </a>
  </div>

  <header class="max-w-4xl mx-auto pt-10 pb-10 text-[var(--white)]">
    <p class="text-lg text-[var(--sec)] shiny-sec mb-3">Selected work</p>
    <h1 class="text-5xl md:text-6xl font-medium leading-none mb-5">
      Research & Patents
    </h1>
    <p class="text-lg text-[var(--white-icon)] max-w-2xl leading-relaxed">
      Eleven peer-reviewed papers and patents across multimodal AI, federated
      learning, biometrics, and applied deep learning. Items with figures open a
      detailed page.
    </p>
  </header>

  <main class="max-w-4xl mx-auto text-[var(--white)] space-y-14 pb-24">
    {
      groupOrder.map((group) => {
        const items = researchItems.filter((i) => i.group === group.key);
        if (!items.length) return null;
        return (
          <section>
            <h2 class="text-sm text-[var(--sec)] mb-4">{group.label}</h2>
            <div class="rounded-2xl border border-[var(--white-icon-tr)] overflow-hidden">
              {items.map((item, idx) => {
                const href = item.slug
                  ? `/research/${item.slug}`
                  : item.links?.[0]?.href;
                const external = !item.slug && Boolean(href);
                const rowClass =
                  "flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 p-4 md:p-5 transition-colors hover:bg-[#ffffff08]" +
                  (idx > 0 ? " border-t border-[var(--white-icon-tr)]" : "");
                const inner = (
                  <>
                    <div class="flex-grow min-w-0">
                      <h3 class="font-medium leading-snug">{item.title}</h3>
                      <p class="text-sm text-[var(--white-icon)] mt-1">
                        {item.venue} · {item.year}
                      </p>
                      {item.summary && (
                        <p class="text-sm text-[var(--white-icon)] mt-1 opacity-80">
                          {item.summary}
                        </p>
                      )}
                    </div>
                    <div class="flex items-center gap-3 sm:flex-col sm:items-end shrink-0">
                      <span
                        class="text-xs border rounded-full px-3 py-1 whitespace-nowrap"
                        style={`color:${statusColor(item.status)};border-color:${statusColor(item.status)}55;`}
                      >
                        {item.status}
                      </span>
                      {href && (
                        <span class="text-sm text-[var(--white-icon)] group-hover:text-white inline-flex items-center gap-1">
                          {item.slug ? "View" : "Paper"}
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                            <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                          </svg>
                        </span>
                      )}
                    </div>
                  </>
                );
                return href ? (
                  <a
                    href={href}
                    class={"group " + rowClass}
                    {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  >
                    {inner}
                  </a>
                ) : (
                  <div class={rowClass}>{inner}</div>
                );
              })}
            </div>
          </section>
        );
      })
    }
  </main>
</Layout>
