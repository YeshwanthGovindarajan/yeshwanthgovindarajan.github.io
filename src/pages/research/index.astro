---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";
import ResearchRows from "@/components/research-rows.astro";
import { scholarlyGroupOrder, scholarlyItems } from "@/data/research";
---

<Layout
  title="Research"
  description="Peer-reviewed journal and conference papers by Yeshwanth Govindarajan."
>
  <Nav />

  <header class="max-w-4xl mx-auto pt-12 md:pt-16 pb-8 text-[var(--white)]">
    <p class="text-lg text-[var(--sec)] mb-2 shiny-sec">Peer-reviewed work</p>
    <h1 class="text-4xl md:text-5xl font-medium mb-4">Research</h1>
    <p class="text-[var(--white-icon)] max-w-2xl leading-relaxed">
      Journal and conference papers with links where published online. Items
      with figures open a detail page. Patents are on the{" "}
      <a href="/patents" class="text-[var(--sec)] hover:underline">Patents</a>{" "}
      page; themed project cards are on{" "}
      <a href="/projects" class="text-[var(--sec)] hover:underline">Projects</a>.
    </p>
  </header>

  <main class="max-w-4xl mx-auto text-[var(--white)] space-y-14 pb-24">
    {
      scholarlyGroupOrder.map((group) => {
        const items = scholarlyItems.filter((i) => i.group === group.key);
        if (!items.length) return null;
        return (
          <section>
            <h2 class="text-sm text-[var(--sec)] mb-4">{group.label}</h2>
            <ResearchRows items={items} />
          </section>
        );
      })
    }
  </main>

  <Footer />
</Layout>
