---
import { workingOnItems } from "@/data/catalog";

const arrowIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" /></svg>`;
---

<section class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Currently working on</h2>
    <p class="text-[var(--white-icon)] mb-6 max-w-2xl">
      Early-stage course and team projects. These pages describe the idea and plan, not final results.
    </p>
    <div class="grid sm:grid-cols-2 gap-4">
      {
        workingOnItems.map((item) => (
          <a
            href={item.href}
            class="group block rounded-2xl border border-[var(--white-icon-tr)] bg-[#14141470] p-5 hover:border-[#ffffff24] transition-colors"
          >
            <div class="flex gap-4 items-start">
              {item.image && (
                <div class="shrink-0 w-20 h-20 rounded-lg overflow-hidden bg-[#f4f4f5] p-1">
                  <img
                    src={item.image}
                    alt=""
                    class="w-full h-full object-contain"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="min-w-0 flex-grow">
                <p class="text-xs text-[var(--sec)] mb-1">{item.status}</p>
                <h4 class="font-medium leading-snug">{item.title}</h4>
                <p class="text-sm text-[var(--white-icon)] mt-2 line-clamp-2">
                  {item.cardLine}
                </p>
              </div>
              <span
                class="text-[var(--white-icon)] group-hover:text-white shrink-0"
                set:html={arrowIcon}
              />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
