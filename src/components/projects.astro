---
import { projects } from "@/data/projects";

const arrowIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" /></svg>`;
const githubIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-7"><path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" /></svg>`;
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => {
          const primaryHref =
            project.caseStudy ?? project.preview ?? project.repo ?? "#";
          const isInternal = Boolean(project.caseStudy);
          return (
            <div class="group">
              <a
                href={primaryHref}
                {...(isInternal
                  ? {}
                  : { target: "_blank", rel: "noopener noreferrer" })}
                class="block"
              >
                <div class="rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4">
                  <img
                    src={project.image}
                    alt={project.title}
                    loading="lazy"
                    class="w-full h-48 md:h-72 object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
                <div class="flex items-center px-3">
                  <div class="flex-grow">
                    <h4 class="text-2xl font-semibold">{project.title}</h4>
                    <span class="py-1 text-sm text-[var(--white-icon)]">
                      {project.status}
                    </span>
                  </div>
                  <div class="flex gap-2 ml-auto">
                    {project.repo && (
                      <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href={project.repo}
                        aria-label="GitHub"
                        class="size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                        set:html={githubIcon}
                      />
                    )}
                    <a
                      {...(isInternal
                        ? {}
                        : { target: "_blank", rel: "noopener noreferrer" })}
                      href={primaryHref}
                      aria-label={isInternal ? "Open case study" : "Preview"}
                      class="size-14 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                      set:html={arrowIcon}
                    />
                  </div>
                </div>
              </a>

              {project.cardLine && (
                <p class="px-3 mt-3 text-sm text-[var(--white-icon)] leading-relaxed">
                  {project.cardLine}
                </p>
              )}

              {project.tags && (
                <div class="px-3 mt-3 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="text-xs text-[var(--white-icon)] border border-[var(--white-icon-tr)] bg-[#1414149c] rounded-full px-3 py-1">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
