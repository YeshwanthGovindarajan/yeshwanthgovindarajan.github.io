---
import PortfolioGrid from "@/components/portfolio-grid.astro";
import { homeStripItems } from "@/data/catalog";
---

<section class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Selected work</h2>
    <h3 class="text-3xl md:text-4xl font-medium mb-8">Projects and research highlights</h3>
    <PortfolioGrid items={homeStripItems} showFilters={false} />
    <a
      href="/projects"
      class="w-full flex items-center justify-center gap-2 mt-10 text-[var(--white-icon)] hover:text-white transition border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
    >
      Browse all by topic
    </a>
  </div>
</section>
